          "fields": [
            "questionnaire_session_id",
            "state_version"
          ],
          "predicate": "target_type_code = 'QUESTIONNAIRE'",
          "unique": true
        },
        {
          "name": "uq_status_history_inquiry_version",
          "target_type_code": "INQUIRY",
