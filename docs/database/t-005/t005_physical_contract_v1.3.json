    "support_inquiry_status_history": {
      "target_integrity": {
        "target_type_field": "target_type_code",
        "target_fks": {
          "QUESTIONNAIRE": "questionnaire_session_id",
          "INQUIRY": "inquiry_id",
          "CONSULTATION": "consultation_id",
          "VISIT": "visit_id"
        },
        "check_constraints": [
          {
            "name": "ck_status_history_exactly_one_target",
            "expression": "num_nonnulls(questionnaire_session_id, inquiry_id, consultation_id, visit_id) = 1"
          },
          {
            "name": "ck_status_history_target_type_matches_fk",
            "expression": "(target_type_code = 'QUESTIONNAIRE' AND questionnaire_session_id IS NOT NULL AND inquiry_id IS NULL AND consultation_id IS NULL AND visit_id IS NULL) OR (target_type_code = 'INQUIRY' AND questionnaire_session_id IS NULL AND inquiry_id IS NOT NULL AND consultation_id IS NULL AND visit_id IS NULL) OR (target_type_code = 'CONSULTATION' AND questionnaire_session_id IS NULL AND inquiry_id IS NULL AND consultation_id IS NOT NULL AND visit_id IS NULL) OR (target_type_code = 'VISIT' AND questionnaire_session_id IS NULL AND inquiry_id IS NULL AND consultation_id IS NULL AND visit_id IS NOT NULL)"
          }
        ]
      },
      "idempotency_key": {
        "type": "varchar(128)",
        "nullable": false,
        "global_unique": false,
        "history_unique": false,
        "request_scope_owner": "workflow_idempotency_record",
        "request_scope_fields": [
          "actor",
          "operation_id",
          "idempotency_key"
        ],
        "trace_only": true
      },
