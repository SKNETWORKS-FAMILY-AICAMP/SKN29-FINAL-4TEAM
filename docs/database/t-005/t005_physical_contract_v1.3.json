          "target_type_code": "CONSULTATION",
          "target_fk": "consultation_id",
          "fields": [
            "consultation_id",
            "event_code",
            "idempotency_key"
          ],
          "predicate": "target_type_code = 'CONSULTATION'",
          "unique": false
        },
        {
