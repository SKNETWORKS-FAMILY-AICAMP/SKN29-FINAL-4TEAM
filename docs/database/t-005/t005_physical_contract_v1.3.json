            "visit_id",
            "event_code",
            "idempotency_key"
          ],
          "predicate": "target_type_code = 'VISIT'",
          "unique": false
        }
      ],
      "state_version": {
        "type": "integer",
        "nullable": false,
        "minimum": 1,
        "aggregate_scoped_unique": [
          "target_type_code",
          "resolved_target_fk",
          "state_version"
        ]
      },
      "postgresql_partial_version_constraints": [
        {
          "name": "uq_status_history_questionnaire_version",
          "target_type_code": "QUESTIONNAIRE",
