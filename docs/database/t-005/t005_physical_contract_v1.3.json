          "name": "ix_status_history_questionnaire_event_idempotency",
          "target_type_code": "QUESTIONNAIRE",
          "target_fk": "questionnaire_session_id",
          "fields": [
            "questionnaire_session_id",
            "event_code",
            "idempotency_key"
          ],
          "predicate": "target_type_code = 'QUESTIONNAIRE'",
          "unique": false
        },
        {
