    "field_service_visit.visit_status_code": "field_service_visit.schedule_status"
  },
  "standard_codes": {
    "usage_guidance_status": [
      "NORMAL",
      "PARTIAL_STOP",
      "TOTAL_STOP",
      "PENDING_CONSULTATION"
    ],
    "visit_schedule_status": [
      "ASSIGNING",
      "SCHEDULING",
      "CONFIRMED",
      "IN_PROGRESS",
      "COMPLETED",
      "FOLLOW_UP_REQUIRED",
      "CANCELLED"
    ],
    "risk_level": [
      "general",
      "caution",
      "danger"
    ]
  },
  "enum_and_seed_policy": {
    "cross_service_source": "contracts/codes/*.yaml",
    "django_representation": "TextChoices with contract parity tests",
    "database_enum": false,
    "synthetic_seed": "Django update_or_create with validated DEMO/SYN identifiers",
    "manual_insert": false
  },
  "scope_boundary": {
    "included": [
      "data design owner baseline",
      "Django Model and Migration input contract",
      "API and AI contract field names",
      "standard code source"
