{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticUser",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "public_id", "user_number", "role", "display_name", "active", "data_classification", "created_at"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "public_id": {"type": "string", "format": "uuid"},
    "user_number": {"type": "string", "pattern": "^(CUS-\\d{4}|CNS-\\d{3}|TEC-\\d{3})$"},
    "role": {"type": "string", "enum": ["CUSTOMER", "CONSULTANT", "TECHNICIAN"]},
    "display_name": {"type": "string", "minLength": 1},
    "active": {"type": "boolean"},
    "data_classification": {"type": "string", "const": "synthetic"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
