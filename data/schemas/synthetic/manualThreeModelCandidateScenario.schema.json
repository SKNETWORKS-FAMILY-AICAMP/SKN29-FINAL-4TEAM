{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManualThreeModelCandidateScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "source_design_id",
    "candidate_status",
    "product",
    "family",
    "variant",
    "title",
    "workflow_kind",
    "expected_outcome",
    "topic_code",
    "request",
    "question_expectations",
    "retrieval_expectation",
    "runtime_profiles",
    "workflow_phases",
    "promotion",
    "data_classification",
    "generated_at"
  ],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^SYN-(IAC606-1(?:0[1-9]|10)|IAC425-1(?:0[1-9]|10)|JAC104-0(?:2[5-9]|3[0-4]))$"},
    "source_design_id": {"type": "string", "pattern": "^SYN-(IAC606-0(?:0[1-9]|10)|IAC425-0(?:0[1-9]|10)|JAC104-0(?:2[5-9]|3[0-4]))$"},
    "candidate_status": {"const": "CANDIDATE"},
    "product": {"type": "object"},
    "family": {"type": "string", "minLength": 1},
    "variant": {"enum": ["CLEAR", "AMBIGUOUS", "PERSISTENT_OR_RISK"]},
    "title": {"type": "string", "minLength": 1},
    "workflow_kind": {"type": "string", "minLength": 1},
    "expected_outcome": {"type": "string", "minLength": 1},
    "topic_code": {"type": "string", "pattern": "^symptom_[a-z0-9_]+$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inquiry_id", "correlation_id", "ai_request_id", "state_version", "raw_symptom", "model_code", "selected_symptoms", "previous_answers"],
      "properties": {
        "inquiry_id": {"type": "string", "format": "uuid"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "ai_request_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "state_version": {"type": "integer", "minimum": 1},
        "raw_symptom": {"type": "string", "minLength": 1, "maxLength": 4000},
        "model_code": {"enum": ["WPUJAC104DWH", "WPUJCC104D", "WPUIAC425SNW", "WPUIAC606SNW"]},
        "selected_symptoms": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "previous_answers": {"type": "array", "maxItems": 50, "items": {"type": "object"}}
      }
    },
    "question_expectations": {"type": "object"},
    "retrieval_expectation": {"type": "object"},
    "runtime_profiles": {"type": "object"},
    "workflow_phases": {"type": "array"},
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["golden", "blockers"],
      "properties": {
        "golden": {"const": false},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "data_classification": {"const": "synthetic"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
