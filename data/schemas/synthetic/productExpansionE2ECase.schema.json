{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductExpansionE2ECase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "scope_status",
    "backend_import_status",
    "runtime_status",
    "product",
    "customer_product",
    "subscription",
    "inquiry",
    "evidence",
    "safety",
    "expected_outcome",
    "promotion",
    "data_classification",
    "generated_at"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^E2E-IAC(425|606)-001$"},
    "scope_status": {"const": "E2E_CANDIDATE"},
    "backend_import_status": {"const": "NOT_IMPORTED"},
    "runtime_status": {"const": "NOT_VERIFIED"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_public_id", "exact_sales_code", "model_family"],
      "properties": {
        "fixture_public_id": {"type": "string", "format": "uuid"},
        "exact_sales_code": {"enum": ["WPUIAC425SNW", "WPUIAC606SNW"]},
        "model_family": {"enum": ["WPU-IAC425", "WPU-IAC606"]}
      }
    },
    "customer_product": {"$ref": "#/$defs/candidateLink"},
    "subscription": {"$ref": "#/$defs/candidateLink"},
    "inquiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ref",
        "subscription_ref",
        "scenario_id",
        "original_text",
        "topic_code"
      ],
      "properties": {
        "candidate_ref": {"type": "string", "pattern": "^CAND-INQ-IAC(425|606)-001$"},
        "subscription_ref": {"type": "string", "pattern": "^CAND-SUB-IAC(425|606)-001$"},
        "scenario_id": {"type": "string", "pattern": "^SYN-IAC(425|606)-001$"},
        "original_text": {"type": "string", "minLength": 1},
        "topic_code": {"enum": ["hot_water_stopped", "no_ice"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_group_id",
        "exact_sales_code",
        "document_id",
        "page_refs",
        "verification_status"
      ],
      "properties": {
        "evidence_group_id": {"type": "string", "pattern": "^EVD-WPUIAC(425|606)SNW-"},
        "exact_sales_code": {"enum": ["WPUIAC425SNW", "WPUIAC606SNW"]},
        "document_id": {"type": "string", "minLength": 1},
        "page_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "verification_status": {"const": "TEXT_AND_VISUAL_VERIFIED"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_level", "requires_consultation", "safe_actions", "consultation_conditions"],
      "properties": {
        "risk_level": {"enum": ["caution", "danger"]},
        "requires_consultation": {"type": "boolean"},
        "safe_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "consultation_conditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_mode", "handoff_target"],
      "properties": {
        "resolution_mode": {"enum": ["CONSULTANT_HANDOFF", "SELF_RESOLUTION"]},
        "handoff_target": {"enum": ["CONSULTANT", "NONE"]}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_fixture_included", "db_handoff_profile_included", "blockers"],
      "properties": {
        "canonical_fixture_included": {"const": false},
        "db_handoff_profile_included": {"const": false},
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "data_classification": {"const": "synthetic"},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "candidateLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref", "parent_ref"],
      "properties": {
        "candidate_ref": {"type": "string", "pattern": "^CAND-(CP|SUB)-IAC(425|606)-001$"},
        "parent_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
