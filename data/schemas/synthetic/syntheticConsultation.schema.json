{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticConsultation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "public_id", "consultation_number", "inquiry_id", "sequence", "consultant_id", "status", "outcome", "summary", "state_version", "idempotency_key", "correlation_id", "created_at", "started_at", "completed_at", "data_classification"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "public_id": {"type": "string", "format": "uuid"},
    "consultation_number": {"type": "string", "pattern": "^CON-SYN-\\d{4}-\\d$"},
    "inquiry_id": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "consultant_id": {"type": ["integer", "null"], "minimum": 1},
    "status": {"type": "string", "enum": ["WAITING", "ASSIGNED", "IN_PROGRESS", "COMPLETED", "CANCELLED"]},
    "outcome": {"type": "string", "enum": ["PENDING", "COMPLETED_NO_VISIT", "VISIT_REQUIRED", "REOPENED_FOLLOWUP"]},
    "summary": {"type": "string", "minLength": 1},
    "state_version": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "data_classification": {"type": "string", "const": "synthetic"}
  }
}
