{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticProduct",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "public_id", "product_code", "product_model", "model_family", "product_generation", "manual_revision", "support_scope", "data_classification"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "public_id": {"type": "string", "format": "uuid"},
    "product_code": {"type": "string", "const": "WPUJAC104DWH"},
    "product_model": {"type": "string", "const": "WPU-JAC104 (D)"},
    "model_family": {"type": "string", "const": "WPU-JAC104"},
    "product_generation": {"type": "string", "const": "D"},
    "manual_revision": {"type": "string", "const": "REV.00"},
    "support_scope": {"type": "string", "const": "MVP"},
    "data_classification": {"type": "string", "const": "synthetic"}
  }
}
