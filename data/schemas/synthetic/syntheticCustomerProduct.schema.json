{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticCustomerProduct",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "public_id", "customer_id", "product_id", "serial_number", "installation_date", "installation_location", "active", "data_classification"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "public_id": {"type": "string", "format": "uuid"},
    "customer_id": {"type": "integer", "minimum": 1},
    "product_id": {"type": "integer", "minimum": 1},
    "serial_number": {"type": "string", "pattern": "^SYN-JAC104D-\\d{4}$"},
    "installation_date": {"type": "string", "format": "date"},
    "installation_location": {"type": "string", "minLength": 1},
    "active": {"type": "boolean"},
    "data_classification": {"type": "string", "const": "synthetic"}
  }
}
