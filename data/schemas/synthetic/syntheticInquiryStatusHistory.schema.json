{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticT005StatusHistory",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "public_id", "status_history_number", "questionnaire_session_id", "inquiry_id", "consultation_id", "visit_id", "target_type_code", "event_code", "from_status_code", "to_status_code", "state_version", "change_reason", "changed_by_id", "changed_by_type_code", "correlation_id", "idempotency_key", "changed_at", "data_classification"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "public_id": {"type": "string", "format": "uuid"},
    "status_history_number": {"type": "string", "pattern": "^SYN-HIST-(QUESTIONNAIRE|INQUIRY|CONSULTATION|VISIT)-\\d{3}-\\d{3}$"},
    "questionnaire_session_id": {"type": ["integer", "null"], "minimum": 1},
    "inquiry_id": {"type": ["integer", "null"], "minimum": 1},
    "consultation_id": {"type": ["integer", "null"], "minimum": 1},
    "visit_id": {"type": ["integer", "null"], "minimum": 1},
    "target_type_code": {"type": "string", "enum": ["QUESTIONNAIRE", "INQUIRY", "CONSULTATION", "VISIT"]},
    "event_code": {"type": "string", "minLength": 1},
    "from_status_code": {"type": ["string", "null"]},
    "to_status_code": {"type": "string", "minLength": 1},
    "state_version": {"type": "integer", "minimum": 1},
    "change_reason": {"type": "string", "minLength": 1},
    "changed_by_id": {"type": ["integer", "null"], "minimum": 1},
    "changed_by_type_code": {"type": "string", "enum": ["USER", "SYSTEM"]},
    "correlation_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "changed_at": {"type": "string", "format": "date-time"},
    "data_classification": {"type": "string", "const": "synthetic"}
  }
}
