{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticAuditEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "public_id", "audit_record_number", "entity_type", "entity_id", "event_type", "actor_role", "actor_id", "state_version", "idempotency_key", "correlation_id", "occurred_at", "data_classification"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "public_id": {"type": "string", "format": "uuid"},
    "audit_record_number": {"type": "string", "pattern": "^SYN-AUDIT-(INQUIRY|VISIT)-\\d{3}-\\d{3}$"},
    "entity_type": {"type": "string", "enum": ["INQUIRY", "VISIT"]},
    "entity_id": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "minLength": 1},
    "actor_role": {"type": "string", "enum": ["CUSTOMER", "CONSULTANT", "TECHNICIAN", "SYSTEM"]},
    "actor_id": {"type": ["integer", "null"], "minimum": 1},
    "state_version": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "format": "uuid"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "data_classification": {"type": "string", "const": "synthetic"}
  }
}
