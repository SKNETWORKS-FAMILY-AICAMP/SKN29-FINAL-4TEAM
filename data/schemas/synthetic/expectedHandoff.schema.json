{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpectedHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "inquiry_public_id",
    "handoff_type",
    "from_role",
    "to_role",
    "required_fields",
    "expected_current_owner_role",
    "generated_at"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SYN-JAC104-\\d{3}$"
    },
    "inquiry_public_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "handoff_type": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "NONE",
        "CONSULTANT",
        "VISIT",
        "REOPEN"
      ]
    },
    "from_role": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "CUSTOMER",
        "SYSTEM",
        "CONSULTANT"
      ]
    },
    "to_role": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "NONE",
        "CONSULTANT",
        "TECHNICIAN"
      ]
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "expected_current_owner_role": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "NONE",
        "CONSULTANT",
        "TECHNICIAN"
      ]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  }
}
