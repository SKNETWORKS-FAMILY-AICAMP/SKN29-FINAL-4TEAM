{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpectedWorkflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "initial_status",
    "steps",
    "final_status",
    "generated_at"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SYN-JAC104-\\d{3}$"
    },
    "initial_status": {
      "type": "string",
      "minLength": 1,
      "const": "DRAFT"
    },
    "steps": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WorkflowStep",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "event",
          "from_status",
          "to_status",
          "actor_role",
          "actor_public_id",
          "state_version",
          "occurred_at",
          "idempotency_key",
          "correlation_id",
          "expected_allowed_actions"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "from_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "DRAFT",
              "QUESTIONNAIRE_IN_PROGRESS",
              "AI_GUIDANCE",
              "CONSULTATION_REQUIRED",
              "CONSULTATION_IN_PROGRESS",
              "VISIT_REVIEW_PENDING",
              "VISIT_SCHEDULING",
              "VISIT_SCHEDULED",
              "COMPLETION_PENDING",
              "REVISIT_REQUIRED",
              "REOPENED",
              "RESOLVED",
              "CANCELLED",
              null
            ]
          },
          "to_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "DRAFT",
              "QUESTIONNAIRE_IN_PROGRESS",
              "AI_GUIDANCE",
              "CONSULTATION_REQUIRED",
              "CONSULTATION_IN_PROGRESS",
              "VISIT_REVIEW_PENDING",
              "VISIT_SCHEDULING",
              "VISIT_SCHEDULED",
              "COMPLETION_PENDING",
              "REVISIT_REQUIRED",
              "REOPENED",
              "RESOLVED",
              "CANCELLED"
            ]
          },
          "visit_from_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ASSIGNING",
              "SCHEDULING",
              "CONFIRMED",
              "IN_PROGRESS",
              "COMPLETED",
              "FOLLOW_UP_REQUIRED",
              "CANCELLED",
              null
            ]
          },
          "visit_to_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ASSIGNING",
              "SCHEDULING",
              "CONFIRMED",
              "IN_PROGRESS",
              "COMPLETED",
              "FOLLOW_UP_REQUIRED",
              "CANCELLED",
              null
            ]
          },
          "visit_state_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "actor_role": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "CUSTOMER",
              "CONSULTANT",
              "TECHNICIAN",
              "SYSTEM"
            ]
          },
          "actor_public_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "state_version": {
            "type": "integer",
            "minimum": 1
          },
          "occurred_at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "expected_allowed_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    },
    "final_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "DRAFT",
        "QUESTIONNAIRE_IN_PROGRESS",
        "AI_GUIDANCE",
        "CONSULTATION_REQUIRED",
        "CONSULTATION_IN_PROGRESS",
        "VISIT_REVIEW_PENDING",
        "VISIT_SCHEDULING",
        "VISIT_SCHEDULED",
        "COMPLETION_PENDING",
        "REVISIT_REQUIRED",
        "REOPENED",
        "RESOLVED",
        "CANCELLED"
      ]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  }
}
