{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticInquiry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inquiry_id",
    "inquiry_number",
    "scenario_id",
    "customer_id",
    "subscription_id",
    "original_text",
    "topic_code",
    "variant",
    "risk_level",
    "usage_guidance_status",
    "status",
    "assigned_role",
    "assigned_user_id",
    "evidence_ids",
    "evidence_mode",
    "requires_fallback",
    "state_version",
    "idempotency_key",
    "correlation_id",
    "data_classification",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "inquiry_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "inquiry_number": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:INQ-\\d{8}-\\d{4}|DEMO-INQ-\\d{3})$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SYN-JAC104-\\d{3}$"
    },
    "customer_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "subscription_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "original_text": {
      "type": "string",
      "minLength": 1
    },
    "topic_code": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "symptom_no_water",
        "symptom_low_flow",
        "symptom_cold_temperature",
        "symptom_leak",
        "symptom_taste_odor",
        "symptom_hot_water_safety",
        "symptom_noise",
        "capability_iot_unsupported"
      ]
    },
    "variant": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "CLEAR",
        "AMBIGUOUS",
        "PERSISTENT_OR_RISK"
      ]
    },
    "risk_level": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "general",
        "caution",
        "danger"
      ]
    },
    "usage_guidance_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "NORMAL",
        "PARTIAL_STOP",
        "TOTAL_STOP",
        "PENDING_CONSULTATION"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "DRAFT",
        "QUESTIONNAIRE_IN_PROGRESS",
        "PRODUCT_VALIDATION_FAILED",
        "AI_GUIDANCE_READY",
        "CONSULTATION_PENDING",
        "CONSULTATION_IN_PROGRESS",
        "VISIT_REVIEW_PENDING",
        "VISIT_PENDING",
        "VISIT_IN_PROGRESS",
        "COMPLETION_PENDING",
        "RESOLVED",
        "REOPENED"
      ]
    },
    "assigned_role": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "NONE",
        "COUNSELOR",
        "TECHNICIAN"
      ]
    },
    "assigned_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^EVD-[A-Z0-9-]+$"
      },
      "minItems": 0
    },
    "evidence_mode": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "EXACT_MODEL",
        "NO_EVIDENCE",
        "PARTIAL_EVIDENCE"
      ]
    },
    "requires_fallback": {
      "type": "boolean"
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "data_classification": {
      "type": "string",
      "minLength": 1,
      "const": "synthetic"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  }
}
