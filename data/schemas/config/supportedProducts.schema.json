{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportedRagProducts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "products", "inactive_manual_aliases", "retrieval_policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "products": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exact_sales_code", "manual_model", "model_family", "product_generation", "document_id", "revision", "source_inventory_id", "manual_pages_path", "rag_parent_pages", "data_status", "runtime_status"],
        "properties": {
          "exact_sales_code": {"enum": ["WPUJAC104DWH", "WPUIAC425SNW", "WPUIAC606SNW"]},
          "manual_model": {"type": "string", "minLength": 1},
          "model_family": {"type": "string", "minLength": 1},
          "product_generation": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "pattern": "^MAN-[A-Z0-9-]+$"},
          "revision": {"type": "string", "pattern": "^REV\\.[0-9]{2}$"},
          "source_inventory_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
          "manual_pages_path": {"type": "string", "minLength": 1},
          "rag_parent_pages": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
          "data_status": {"enum": ["MVP_VERIFIED", "RAG_READY_LIMITED_SCOPE"]},
          "runtime_status": {"enum": ["INDEXED_MVP", "CONTRACT_BLOCKED_NOT_INDEXED"]}
        }
      }
    },
    "inactive_manual_aliases": {"type": "array", "items": {"type": "object"}},
    "retrieval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filter_field", "filter_required_before_scoring", "cross_model_fallback", "model_unverified_faq_included"],
      "properties": {
        "filter_field": {"const": "exact_sales_code"},
        "filter_required_before_scoring": {"const": true},
        "cross_model_fallback": {"const": false},
        "model_unverified_faq_included": {"const": false}
      }
    }
  }
}
