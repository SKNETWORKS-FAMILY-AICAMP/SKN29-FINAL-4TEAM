{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceContractMappingConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapping_version",
    "scope",
    "status",
    "state_machine_contract",
    "contract_sources",
    "canonical_role_codes",
    "legacy_role_aliases",
    "canonical_inquiry_statuses",
    "canonical_visit_statuses",
    "legacy_state_aliases",
    "compound_state_mappings",
    "status_history_policy",
    "identifier_policy",
    "product_validation_expectation",
    "blocked_decisions"
  ],
  "properties": {
    "mapping_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "const": "data_contract_alignment"
    },
    "status": {
      "const": "PARTIAL_BLOCKED_DECISIONS"
    },
    "state_machine_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "data_projection_consumes_contract",
        "backend_runtime_verified"
      ],
      "properties": {
        "version": {"const": "1.0.0"},
        "status": {"const": "TEAM_APPROVED"},
        "data_projection_consumes_contract": {"const": true},
        "backend_runtime_verified": {"const": false}
      }
    },
    "contract_sources": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(contracts|docs)/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          }
        }
      }
    },
    "canonical_role_codes": {
      "type": "array",
      "const": ["CUSTOMER", "CONSULTANT", "TECHNICIAN", "OPERATOR"]
    },
    "legacy_role_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["COUNSELOR"],
      "properties": {
        "COUNSELOR": {
          "const": "CONSULTANT"
        }
      }
    },
    "canonical_inquiry_statuses": {
      "type": "array",
      "minItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "canonical_visit_statuses": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "legacy_state_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AI_GUIDANCE_READY", "CONSULTATION_PENDING"],
      "properties": {
        "AI_GUIDANCE_READY": {"const": "AI_GUIDANCE"},
        "CONSULTATION_PENDING": {"const": "CONSULTATION_REQUIRED"}
      }
    },
    "compound_state_mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VISIT_PENDING", "VISIT_IN_PROGRESS"],
      "properties": {
        "VISIT_PENDING": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inquiry_status", "visit_status"],
          "properties": {
            "inquiry_status": {"const": "VISIT_SCHEDULED"},
            "visit_status": {"const": "CONFIRMED"}
          }
        },
        "VISIT_IN_PROGRESS": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inquiry_status", "visit_status"],
          "properties": {
            "inquiry_status": {"const": "VISIT_SCHEDULED"},
            "visit_status": {"const": "IN_PROGRESS"}
          }
        }
      }
    },
    "status_history_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type_codes",
        "target_fk_fields",
        "exactly_one_target_fk",
        "idempotency_key_unique",
        "idempotency_key_role",
        "state_version_unique_scope"
      ],
      "properties": {
        "target_type_codes": {
          "type": "array",
          "const": ["QUESTIONNAIRE", "INQUIRY", "CONSULTATION", "VISIT"]
        },
        "target_fk_fields": {
          "type": "object",
          "const": {
            "QUESTIONNAIRE": "questionnaire_session_id",
            "INQUIRY": "inquiry_id",
            "CONSULTATION": "consultation_id",
            "VISIT": "visit_id"
          }
        },
        "exactly_one_target_fk": {"const": true},
        "idempotency_key_unique": {"const": false},
        "idempotency_key_role": {"const": "REQUEST_HISTORY_TRACE"},
        "state_version_unique_scope": {
          "type": "array",
          "const": ["target_type_code", "resolved_target_fk", "state_version"]
        }
      }
    },
    "identifier_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_primary_key",
        "public_identifier",
        "business_identifier_prefixes",
        "fixture_foreign_keys_use",
        "expected_api_identifiers_use"
      ],
      "properties": {
        "internal_primary_key": {"const": "INTEGER_ID"},
        "public_identifier": {"const": "UUID_PUBLIC_ID"},
        "business_identifier_prefixes": {
          "type": "array",
          "const": ["DEMO-", "SYN-"]
        },
        "fixture_foreign_keys_use": {"const": "INTEGER_ID"},
        "expected_api_identifiers_use": {"const": "UUID_PUBLIC_ID"}
      }
    },
    "product_validation_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_code",
        "to_inquiry_status",
        "materialize_event_as_inquiry_status"
      ],
      "properties": {
        "event_code": {"const": "PRODUCT_VALIDATION_FAILED"},
        "to_inquiry_status": {"const": "CONSULTATION_REQUIRED"},
        "materialize_event_as_inquiry_status": {"const": false}
      }
    },
    "blocked_decisions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "affected_scenario_ids",
          "treatment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-[A-Z0-9-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affected_scenario_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SYN-JAC104-[0-9]{3}$"
            }
          },
          "treatment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
