{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RagEvaluationCases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "status",
    "approved_chunk_count",
    "evaluation_policy",
    "cases",
    "ai_execution"
  ],
  "properties": {
    "config_version": {"const": "1.1.2"},
    "status": {"const": "DATA_EXPECTATION_AND_AI_EXECUTION_VERIFIED"},
    "approved_chunk_count": {"const": 7},
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_top_k",
        "positive_min_expected_hits",
        "negative_max_forbidden_hits",
        "required_result_metadata"
      ],
      "properties": {
        "default_top_k": {"type": "integer", "minimum": 1},
        "positive_min_expected_hits": {"const": 1},
        "negative_max_forbidden_hits": {"const": 0},
        "required_result_metadata": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_type",
          "scenario_id",
          "query",
          "product_model_code",
          "expected_chunk_ids",
          "expected_document_id",
          "expected_page_numbers",
          "forbidden_model_codes",
          "forbidden_document_ids",
          "top_k",
          "expected_no_evidence"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^RAG-(POS|NEG)-[A-Z0-9-]+$"},
          "case_type": {"enum": ["POSITIVE", "NEGATIVE_SCOPE", "NEGATIVE_SOURCE"]},
          "scenario_id": {
            "type": ["string", "null"],
            "pattern": "^SYN-JAC104-[0-9]{3}$"
          },
          "query": {"type": "string", "minLength": 1},
          "product_model_code": {"type": "string", "minLength": 1},
          "expected_chunk_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_document_id": {"type": ["string", "null"], "minLength": 1},
          "expected_page_numbers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "forbidden_model_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_document_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "top_k": {"type": "integer", "minimum": 1},
          "expected_no_evidence": {"type": "boolean"}
        }
      }
    },
    "ai_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approval_scope",
        "owner",
        "hash_policy",
        "evaluated_contract_sha256",
        "canonical_dataset",
        "result_manifest",
        "index_manifest",
        "limitations"
      ],
      "properties": {
        "status": {"const": "PASS"},
        "approval_scope": {"const": "APPROVED_FOR_MVP_INGEST"},
        "owner": {"const": "LEE_DONGYUN"},
        "hash_policy": {"const": "UTF8_LF_NO_BOM"},
        "evaluated_contract_sha256": {
          "const": "EFE99197B3DE5CC9076BC2BF39BAF46136CE2A669D7899CBA67D74F8CA04BE79"
        },
        "canonical_dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "records", "sha256"],
          "properties": {
            "path": {
              "const": "data/processed/structured/rag/mvp/rag_verified_sample.jsonl"
            },
            "records": {"const": 7},
            "sha256": {
              "const": "2BF3582E42A309D846BC383BE9C3E08874512318DD4046082498DBFBC8584DD0"
            }
          }
        },
        "result_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "received_sha256",
            "verification_status",
            "case_count",
            "passed_count",
            "failed_count"
          ],
          "properties": {
            "path": {
              "const": "ai/evaluation/reports/pgvector_verification.json"
            },
            "sha256": {
              "const": "449F8D1A3298FFD5BF945E405F51A4FED5767E6502D1B390BD70FCC06AF27DD1"
            },
            "received_sha256": {
              "const": "0C5EC8431B9DA2689CBEA5218B21AB75E9572FEC8CE308764CC952D41ADBAD13"
            },
            "verification_status": {"const": "PASS"},
            "case_count": {"const": 12},
            "passed_count": {"const": 12},
            "failed_count": {"const": 0}
          }
        },
        "index_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "received_sha256",
            "embedding_model",
            "embedding_model_version",
            "index_version",
            "dimension",
            "chunk_set_sha256"
          ],
          "properties": {
            "path": {"const": "ai/configs/index_manifest.json"},
            "sha256": {
              "const": "76672253A536DFD253CA15770C08F781BC72BE6D2C6EE0AC1C15CA24971564A2"
            },
            "received_sha256": {
              "const": "928AB09B4357C699C90463F321A4E39C678137FEA8A98C3D4AC9471C26E7ADBF"
            },
            "embedding_model": {"const": "BAAI/bge-m3"},
            "embedding_model_version": {
              "const": "5617a9f61b028005a4858fdac845db406aefb181"
            },
            "index_version": {"const": "1.0.0"},
            "dimension": {"const": 1024},
            "chunk_set_sha256": {
              "const": "175065B3A487D73FF5B06F359B018CEA416719C88684EDA58C33C996107C9958"
            }
          }
        },
        "limitations": {
          "type": "array",
          "const": [
            "JAC104D_D_GENERATION_REV00_PAGES_37_39_SEVEN_TOPICS_ONLY",
            "RAG_POS_LEAK_EXPECTED_CHUNK_RANK_5"
          ]
        }
      }
    }
  }
}
