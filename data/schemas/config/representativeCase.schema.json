{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepresentativeE2EContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "scenario_id",
    "inquiry_number",
    "product_code",
    "document_id",
    "topic_code",
    "rag_chunk_id",
    "evidence_id",
    "manual_page",
    "risk_level",
    "usage_guidance_status",
    "final_status",
    "final_state_version",
    "final_actor_role",
    "expected_events",
    "expected_counts",
    "document_sections"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scenario_id": {
      "type": "string",
      "const": "SYN-JAC104-002"
    },
    "inquiry_number": {
      "type": "string",
      "const": "DEMO-INQ-002"
    },
    "product_code": {
      "type": "string",
      "const": "WPUJAC104DWH"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "topic_code": {
      "type": "string",
      "const": "symptom_low_flow"
    },
    "rag_chunk_id": {
      "type": "string",
      "const": "RAG-WPUJAC104DWH-LOW-FLOW-001"
    },
    "evidence_id": {
      "type": "string",
      "const": "EVD-WPUJAC104DWH-LOW-FLOW-001"
    },
    "manual_page": {
      "type": "integer",
      "const": 38
    },
    "risk_level": {
      "type": "string",
      "const": "general"
    },
    "usage_guidance_status": {
      "type": "string",
      "const": "NORMAL"
    },
    "final_status": {
      "type": "string",
      "const": "RESOLVED"
    },
    "final_state_version": {
      "type": "integer",
      "const": 14
    },
    "final_actor_role": {
      "type": "string",
      "const": "TECHNICIAN"
    },
    "expected_events": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inquiries",
        "consultations",
        "visits",
        "care_histories",
        "followup_confirmations",
        "inquiry_status_histories",
        "audit_events",
        "representative_steps"
      ],
      "properties": {
        "inquiries": {"type": "integer", "const": 22},
        "consultations": {"type": "integer", "const": 12},
        "visits": {"type": "integer", "const": 4},
        "care_histories": {"type": "integer", "const": 25},
        "followup_confirmations": {"type": "integer", "const": 1},
        "inquiry_status_histories": {"type": "integer", "const": 125},
        "audit_events": {"type": "integer", "const": 125},
        "representative_steps": {"type": "integer", "const": 14}
      }
    },
    "document_sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "heading",
          "required_tokens"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/"
          },
          "heading": {
            "type": "string",
            "pattern": "^#{1,6} "
          },
          "required_tokens": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
