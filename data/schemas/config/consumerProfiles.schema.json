{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsumerHandoffProfiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "dataset_scope",
    "service_contracts_used",
    "contract_alignment",
    "profiles"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dataset_scope": {
      "const": "consumer_handoff_only"
    },
    "service_contracts_used": {
      "const": true
    },
    "contract_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_machine_version",
        "state_machine_status",
        "data_projection_consumes_contract",
        "backend_runtime_verified",
        "legacy_service_contracts_used_semantics"
      ],
      "properties": {
        "state_machine_version": {"const": "1.0.0"},
        "state_machine_status": {"const": "TEAM_APPROVED"},
        "data_projection_consumes_contract": {"const": true},
        "backend_runtime_verified": {"const": true},
        "legacy_service_contracts_used_semantics": {
          "const": "BACKEND_RUNTIME_INTEGRATION_ONLY"
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rag", "db-smoke", "db-full", "qa"],
      "properties": {
        "rag": {"$ref": "#/$defs/profile"},
        "db-smoke": {"$ref": "#/$defs/profile"},
        "db-full": {"$ref": "#/$defs/profile"},
        "qa": {"$ref": "#/$defs/profile"}
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "readiness",
        "contract_dependency",
        "items",
        "selection",
        "excluded",
        "commands"
      ],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "readiness": {"type": "string", "minLength": 1},
        "contract_dependency": {
          "enum": [
            "NONE",
            "BACKEND_RUNTIME_MAPPING_PENDING",
            "BACKEND_RUNTIME_VERIFICATION_PENDING"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1}
            }
          }
        },
        "selection": {"type": "object"},
        "excluded": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
