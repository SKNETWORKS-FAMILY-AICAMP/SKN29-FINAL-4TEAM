{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowRulesConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "inquiry_statuses",
    "consultation_statuses",
    "visit_statuses",
    "risk_levels",
    "usage_guidance_statuses",
    "allowed_actions"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "inquiry_statuses": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "consultation_statuses": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "visit_statuses": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "risk_levels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["general", "caution", "danger"]}
    },
    "usage_guidance_statuses": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "NORMAL",
          "PARTIAL_STOP",
          "TOTAL_STOP",
          "PENDING_CONSULTATION"
        ]
      }
    },
    "allowed_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DRAFT",
        "QUESTIONNAIRE_IN_PROGRESS",
        "PRODUCT_VALIDATION_FAILED",
        "AI_GUIDANCE_READY",
        "CONSULTATION_PENDING",
        "CONSULTATION_IN_PROGRESS",
        "VISIT_REVIEW_PENDING",
        "VISIT_PENDING",
        "VISIT_IN_PROGRESS",
        "COMPLETION_PENDING",
        "RESOLVED",
        "REOPENED"
      ],
      "properties": {
        "DRAFT": {"$ref": "#/$defs/actionList"},
        "QUESTIONNAIRE_IN_PROGRESS": {"$ref": "#/$defs/actionList"},
        "PRODUCT_VALIDATION_FAILED": {"$ref": "#/$defs/actionList"},
        "AI_GUIDANCE_READY": {"$ref": "#/$defs/actionList"},
        "CONSULTATION_PENDING": {"$ref": "#/$defs/actionList"},
        "CONSULTATION_IN_PROGRESS": {"$ref": "#/$defs/actionList"},
        "VISIT_REVIEW_PENDING": {"$ref": "#/$defs/actionList"},
        "VISIT_PENDING": {"$ref": "#/$defs/actionList"},
        "VISIT_IN_PROGRESS": {"$ref": "#/$defs/actionList"},
        "COMPLETION_PENDING": {"$ref": "#/$defs/actionList"},
        "RESOLVED": {"$ref": "#/$defs/actionList"},
        "REOPENED": {"$ref": "#/$defs/actionList"}
      }
    }
  },
  "$defs": {
    "actionList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "SUBMIT_SYMPTOM",
          "SUBMIT_ANSWERS",
          "UPDATE_PRODUCT",
          "CUSTOMER_REPORTED_SELF_RESOLVED",
          "REQUEST_CONSULTATION",
          "START_CONSULTATION",
          "CONSULTATION_COMPLETED",
          "VISIT_NEEDED",
          "UPDATE_VISIT_SCHEDULE",
          "CONFIRM_VISIT",
          "START_VISIT",
          "VISIT_COMPLETED",
          "SUBMIT_RESOLUTION_FEEDBACK",
          "FINALIZE_INQUIRY",
          "RESUME_CONSULTATION"
        ]
      }
    }
  }
}
