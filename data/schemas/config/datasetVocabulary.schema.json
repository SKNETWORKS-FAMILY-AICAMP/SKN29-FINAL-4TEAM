{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetVocabularyConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "scope",
    "service_contract_mapping",
    "inquiry_statuses",
    "visit_statuses",
    "risk_levels",
    "usage_guidance_statuses"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "const": "dataset_validation_only"
    },
    "service_contract_mapping": {
      "const": "partial_with_blocked_decisions"
    },
    "inquiry_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "visit_statuses": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ASSIGNING",
          "SCHEDULING",
          "CONFIRMED",
          "IN_PROGRESS",
          "COMPLETED",
          "FOLLOW_UP_REQUIRED",
          "CANCELLED"
        ]
      }
    },
    "risk_levels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["general", "caution", "danger"]
      }
    },
    "usage_guidance_statuses": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "NORMAL",
          "PARTIAL_STOP",
          "TOTAL_STOP",
          "PENDING_CONSULTATION"
        ]
      }
    }
  }
}
