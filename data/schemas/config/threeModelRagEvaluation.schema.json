{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreeModelRagEvaluationDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "status", "human_review_status", "retrieval_acceptance", "generated_at", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"const": "RAG-3MODEL-EVALUATION-DRAFT-V1"},
    "status": {"const": "DATA_READY_AI_NOT_RUN"},
    "human_review_status": {"const": "HUMAN_REVIEW_PENDING"},
    "retrieval_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "positive_rule_id", "positive_match_mode", "positive_top_k", "required_variant_verification_status", "negative", "cross_model_hits"],
      "properties": {
        "positive": {"const": "기대 Evidence Group별 검증된 Source Variant 중 하나 이상이 Top-5에 포함"},
        "positive_rule_id": {"const": "RAG-EVAL-GROUP-TOP5-001"},
        "positive_match_mode": {"const": "AT_LEAST_ONE_VERIFIED_VARIANT_PER_EXPECTED_GROUP"},
        "positive_top_k": {"const": 5},
        "required_variant_verification_status": {"const": "TEXT_AND_VISUAL_VERIFIED"},
        "negative": {"const": "no-evidence"},
        "cross_model_hits": {"const": 0}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "cases": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "case_type", "query", "exact_sales_code", "expected_evidence_group_ids", "forbidden_model_codes", "expected_no_evidence", "data_status", "human_review_status"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^RAG3-(POS|NEG)-\\d{3}$"},
          "case_type": {"enum": ["POSITIVE", "NEGATIVE"]},
          "query": {"type": "string", "minLength": 1},
          "exact_sales_code": {"type": "string", "minLength": 1},
          "expected_evidence_group_ids": {"type": "array", "items": {"type": "string"}},
          "forbidden_model_codes": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "expected_no_evidence": {"type": "boolean"},
          "negative_reason": {"type": "string", "minLength": 1},
          "data_status": {"const": "DATA_READY_AI_NOT_RUN"},
          "human_review_status": {"const": "HUMAN_REVIEW_PENDING"}
        }
      }
    }
  }
}
