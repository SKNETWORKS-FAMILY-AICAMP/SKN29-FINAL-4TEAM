{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iac425GoldCandidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "generated_at", "source_gold_dataset_sha256", "source_evaluation_sha256", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "IAC425_GOLD_CANDIDATES_READY"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_gold_dataset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source_evaluation_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "candidates": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id", "source_case_id", "query", "query_variant_type",
          "product_model_code", "expected_evidence_variants", "forbidden_model_codes",
          "expected_no_evidence", "proposed_risk_level", "proposed_guidance_policy",
          "proposed_split", "human_review_status", "merge_status"
        ],
        "properties": {
          "candidate_id": {"pattern": "^RAGV2-IAC425-CAND-[0-9]{3}$"},
          "source_case_id": {"pattern": "^RAG3-POS-[0-9]{3}$"},
          "query": {"type": "string", "minLength": 1},
          "query_variant_type": {"const": "DIRECT"},
          "product_model_code": {"const": "WPUIAC425SNW"},
          "expected_evidence_variants": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "forbidden_model_codes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "expected_no_evidence": {"const": false},
          "proposed_risk_level": {"enum": ["general", "caution", "danger"]},
          "proposed_guidance_policy": {"enum": ["NORMAL", "PARTIAL_STOP", "TOTAL_STOP", "PENDING_CONSULTATION"]},
          "proposed_split": {"const": "DEV"},
          "human_review_status": {"const": "HUMAN_REVIEW_PENDING"},
          "merge_status": {"const": "AI_OWNER_AND_SECOND_REVIEWER_APPROVAL_REQUIRED"}
        }
      }
    }
  }
}
