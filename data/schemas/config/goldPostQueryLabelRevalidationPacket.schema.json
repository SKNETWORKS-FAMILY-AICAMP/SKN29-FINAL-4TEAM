{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldPostQueryLabelRevalidationPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "source_dataset",
    "source_query_proposals",
    "source_query_review",
    "summary",
    "reviews"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "GOLD_POST_QUERY_LABEL_REVALIDATION_READY_HUMAN_SIGNOFF_PENDING"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_dataset": {"$ref": "#/$defs/sourceDataset"},
    "source_query_proposals": {"$ref": "#/$defs/sourceFile"},
    "source_query_review": {
      "allOf": [
        {"$ref": "#/$defs/sourceFile"},
        {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_counts",
        "reviewed_records",
        "human_signed_records",
        "human_signoff_status",
        "automatic_gold_update"
      ],
      "properties": {
        "assessment_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "reviewed_records": {"const": 60},
        "human_signed_records": {"const": 0},
        "human_signoff_status": {"const": "PENDING"},
        "automatic_gold_update": {"const": false}
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {"$ref": "#/$defs/review"}
    }
  },
  "$defs": {
    "sourceDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "record_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "record_count": {"const": 60}
      }
    },
    "sourceFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "approved_query",
        "query_decision",
        "intent_change",
        "assistant_assessment",
        "assistant_reason",
        "review_priority",
        "human_signoff_status",
        "current_labels",
        "proposed_changes",
        "source_review_context",
        "required_human_checks"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^RAGV2-GOLD-[0-9]{4}$"},
        "approved_query": {"type": ["string", "null"]},
        "query_decision": {"type": "string", "minLength": 1},
        "intent_change": {"type": "boolean"},
        "assistant_assessment": {
          "enum": ["SUPPORTED", "CHANGE_PROPOSED", "REJECT_PROPOSED", "SOURCE_CHECK_REQUIRED"]
        },
        "assistant_reason": {"type": "string", "minLength": 1},
        "review_priority": {"enum": ["HIGH", "MEDIUM", "NORMAL"]},
        "human_signoff_status": {"const": "PENDING"},
        "current_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query_variant_type",
            "expected_no_evidence",
            "evidence_match_policy",
            "expected_evidence",
            "expected_risk_level",
            "expected_guidance_policy"
          ],
          "properties": {
            "query_variant_type": {"type": "string", "minLength": 1},
            "expected_no_evidence": {"type": "boolean"},
            "evidence_match_policy": {"enum": ["ANY", "ALL", "NONE"]},
            "expected_evidence": {"type": "array", "items": {"type": "object"}},
            "expected_risk_level": {"type": "string", "minLength": 1},
            "expected_guidance_policy": {"type": "string", "minLength": 1}
          }
        },
        "proposed_changes": {"type": "array", "items": {"type": "object"}},
        "source_review_context": {"type": "array", "items": {"type": "object"}},
        "required_human_checks": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
