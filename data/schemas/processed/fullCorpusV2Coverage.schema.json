{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FullCorpusV2Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "generated_at", "pages"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "FULL_CORPUS_V2_DATA_HANDOFF_READY"},
    "generated_at": {"type": "string", "format": "date-time"},
    "pages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "total_lines", "assignments"],
        "properties": {
          "page": {"enum": [5, 7, 37, 38, 39]},
          "total_lines": {"type": "integer", "minimum": 1},
          "assignments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line_number", "classification", "record_id", "line_sha256"],
              "properties": {
                "line_number": {"type": "integer", "minimum": 1},
                "classification": {"enum": ["CHILD", "PRESERVATION", "NON_SEARCHABLE_STRUCTURE"]},
                "record_id": {"type": "string", "minLength": 1},
                "line_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
