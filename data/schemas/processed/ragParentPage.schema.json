{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreeModelRagParentPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent_id", "record_type", "retrieval_role", "exact_sales_code",
    "product_model", "model_family", "product_generation", "document_id",
    "version", "page_id", "page_refs", "section_title", "parent_text",
    "parent_text_sha256", "source_page_text_sha256", "source_file_sha256",
    "source_type", "provider", "allowed_use", "verification_status", "generated_at"
  ],
  "properties": {
    "parent_id": {"type": "string", "pattern": "^PARENT-[A-Z0-9]+-P\\d{3}$"},
    "record_type": {"const": "parent"},
    "retrieval_role": {"const": "CONTEXT_ONLY"},
    "exact_sales_code": {"enum": ["WPUJAC104DWH", "WPUIAC425SNW", "WPUIAC606SNW"]},
    "product_model": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "product_generation": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "version": {"enum": ["REV.00", "REV.02"]},
    "page_id": {"type": "string", "pattern": "^MAN-SKMAGIC-.+-P\\d{3}$"},
    "page_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 1}},
    "section_title": {"type": "string", "minLength": 1},
    "parent_text": {"type": "string", "minLength": 1},
    "parent_text_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source_page_text_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source_file_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source_type": {"const": "official_manual"},
    "provider": {"const": "SK매직"},
    "allowed_use": {"const": "RAG_HANDOFF_ONLY"},
    "verification_status": {"const": "TEXT_AND_VISUAL_VERIFIED"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
