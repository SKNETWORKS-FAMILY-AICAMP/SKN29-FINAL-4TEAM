{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreeModelRagChildChunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "child_id", "record_type", "retrieval_role", "child_text", "child_text_sha256",
    "exact_sales_code", "product_model", "model_family", "product_generation",
    "document_id", "version", "parent_id", "parent_text_sha256", "page_id",
    "page_refs", "section_title", "evidence_group_id", "source_variant_id",
    "source_span", "source_file_sha256", "source_page_text_sha256", "risk_level",
    "safe_actions", "requires_consultation", "consultation_conditions", "allowed_use",
    "verification_status", "generated_at"
  ],
  "properties": {
    "child_id": {"type": "string", "pattern": "^CHILD-[A-Z0-9]+-P\\d{3}-.+-001$"},
    "record_type": {"const": "child"},
    "retrieval_role": {"const": "SEARCH_CANDIDATE"},
    "child_text": {"type": "string", "minLength": 1},
    "child_text_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "exact_sales_code": {"enum": ["WPUJAC104DWH", "WPUIAC425SNW", "WPUIAC606SNW"]},
    "product_model": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "product_generation": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "version": {"enum": ["REV.00", "REV.02"]},
    "parent_id": {"type": "string", "minLength": 1},
    "parent_text_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "page_id": {"type": "string", "minLength": 1},
    "page_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 1}},
    "section_title": {"type": "string", "minLength": 1},
    "evidence_group_id": {"type": "string", "pattern": "^EVD-[A-Z0-9]+-.+-001$"},
    "source_variant_id": {"type": "string", "minLength": 1},
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "row_label", "line_start", "line_end", "start_anchor", "end_anchor", "raw_span_sha256"],
      "properties": {
        "type": {"enum": ["PARAGRAPH", "TABLE_ROW_OR_PARAGRAPH"]},
        "row_label": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "start_anchor": {"type": "string", "minLength": 1},
        "end_anchor": {"type": "string", "minLength": 1},
        "raw_span_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "correction_id": {"type": "string", "minLength": 1}
      }
    },
    "source_file_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source_page_text_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "risk_level": {"enum": ["general", "caution", "danger"]},
    "safe_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requires_consultation": {"type": "boolean"},
    "consultation_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "allowed_use": {"const": "RAG_HANDOFF_ONLY"},
    "verification_status": {"const": "TEXT_AND_VISUAL_VERIFIED"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
