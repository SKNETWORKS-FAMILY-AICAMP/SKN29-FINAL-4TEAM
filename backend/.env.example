# 공개 가능한 로컬 개발 예시입니다.
# 이 파일을 backend/.env로 복사한 뒤 모든 replace-with-* 값을 교체합니다.
# 실제 Django Secret Key와 PostgreSQL Password는 Git에 커밋하지 않습니다.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=.runtime/logs/backend.jsonl
DJANGO_DEMO_LOGIN_ENABLED=false
DJANGO_DEMO_LOGIN_CODES=DEMO-CUSTOMER-001,DEMO-CONSULTANT-001,DEMO-TECHNICIAN-001,DEMO-OPERATOR-001,SYN-CUSTOMER-001
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_MODE=local
AI_HANDOFF_INTERNAL_TOKEN=replace-with-a-protected-ai-handoff-token
AI_MODEL_PROVIDER=waterbridge-local
AI_MODEL_NAME=single-rag-pipeline
AI_PROMPT_VERSION=unknown

# P1-A 합성 계약 이메일 보호 키입니다. 각각 독립된 32-byte URL-safe
# base64 값을 사용하고 Git·문서·로그에 실제 값을 기록하지 않습니다.
CONTRACT_EMAIL_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
CONTRACT_EMAIL_HMAC_KEY=replace-with-another-url-safe-base64-32-byte-key
CONTRACT_EMAIL_KEY_VERSION=local-v1

# P1 이메일 OTP Runtime. Secret과 SMTP Password는 실제 값을 Git에
# 커밋하지 않습니다. 합성 계약 이메일은 아래 단일 시험 수신함으로만
# redirect하여 실제 개인정보를 DB에 저장하지 않습니다.
P1_AUTH_HMAC_SECRET=replace-with-an-independent-secret-at-least-32-bytes
P1_AUTH_OTP_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
P1_AUTH_EMAIL_REDIRECT_TO=replace-with-a-controlled-test-inbox
P1_AUTH_OTP_TTL_SECONDS=300
P1_AUTH_OTP_RESEND_SECONDS=60
P1_AUTH_OTP_MAX_FAILURES=5
P1_AUTH_TICKET_TTL_SECONDS=300
P1_AUTH_IDEMPOTENCY_REPLAY_TTL_SECONDS=300
P1_AUTH_CHALLENGE_WINDOW_HOURS=1
P1_AUTH_CHALLENGE_MAX_PER_WINDOW=5
P1_AUTH_LOGIN_WINDOW_SECONDS=300
P1_AUTH_LOGIN_MAX_FAILURES=5
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.invalid
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-smtp-user
DJANGO_EMAIL_HOST_PASSWORD=replace-with-smtp-password
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT_SECONDS=10
DJANGO_DEFAULT_FROM_EMAIL=no-reply@waterbridge.invalid

POSTGRES_DB=waterbridge
POSTGRES_USER=watercare_app
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Local Compose only. TEAM_INTEGRATION and production use verify-full.
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_SSLMODE=disable
POSTGRES_SSLROOTCERT=
