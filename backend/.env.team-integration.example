# TEAM_INTEGRATION Role 생성에만 사용하는 비밀값 자리표시자입니다.
# 실제 파일명은 .env.team-integration이며 Git에 포함하지 않습니다.
# 실제 값은 Password Manager 또는 승인된 1회성 보안 전달로만 공유합니다.
TEAM_INTEGRATION_MIGRATOR_PASSWORD=replace-with-a-unique-migrator-password
TEAM_INTEGRATION_RUNTIME_PASSWORD=replace-with-a-unique-runtime-password
TEAM_INTEGRATION_READONLY_PASSWORD=replace-with-a-unique-readonly-password
TEAM_INTEGRATION_AI_PASSWORD=replace-with-a-unique-ai-readonly-password
