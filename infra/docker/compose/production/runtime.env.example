# Non-secret deployment coordinates only. Runtime credentials remain in the
# protected EC2 environment files referenced by BACKEND_RUNTIME_ENV_FILE and
# AI_RUNTIME_ENV_FILE.
RELEASE_SHA=0000000000000000000000000000000000000000
AWS_REGION=ap-northeast-2
TEMPO_S3_BUCKET=replace-with-bootstrap-stack-output
WEB_HOST_PORT=18080
BACKEND_RUNTIME_ENV_FILE=/etc/waterbridge/backend.env
AI_RUNTIME_ENV_FILE=/etc/waterbridge/ai.env
RDS_CA_HOST_PATH=/etc/waterbridge/certs/rds-ca.pem
WEB_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/waterbridge/web
WEB_IMAGE_DIGEST=sha256:replace-with-ecr-digest
BACKEND_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/waterbridge/backend
BACKEND_IMAGE_DIGEST=sha256:replace-with-ecr-digest
AI_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/waterbridge/ai
AI_IMAGE_DIGEST=sha256:replace-with-ecr-digest
