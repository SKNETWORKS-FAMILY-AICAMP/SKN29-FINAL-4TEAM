# TEAM_INTEGRATION QA Host 구조 예시입니다. 실제 Secret은 기록하지 않습니다.
# 로컬 사전검증 기본값이며 TEAM_SHARED 판정에는 별도 TLS Endpoint가 필요합니다.
POSTGRES_DB=postgres
POSTGRES_USER=waterbridge_ti_admin
POSTGRES_PASSWORD=<secret-manager-or-runtime-file>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_SSLMODE=disable

TEAM_INTEGRATION_MIGRATOR_PASSWORD=<secret-manager-or-runtime-file>
TEAM_INTEGRATION_RUNTIME_PASSWORD=<secret-manager-or-runtime-file>
TEAM_INTEGRATION_READONLY_PASSWORD=<secret-manager-or-runtime-file>
TEAM_INTEGRATION_AI_PASSWORD=<secret-manager-or-runtime-file>
