{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watercare.local/contracts/ai/4.0.0/common/ModelMetadata.schema.json",
  "x-contract-version": "4.0.0",
  "title": "ModelMetadata",
  "description": "내부 실행 감사용 모델 메타데이터. 공개 고객 응답에는 포함하지 않는다.",
  "type": "object",
  "required": ["model_name", "prompt_version"],
  "additionalProperties": false,
  "properties": {
    "model_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tokens_used": { "type": ["integer", "null"], "minimum": 0 },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 }
  }
}
