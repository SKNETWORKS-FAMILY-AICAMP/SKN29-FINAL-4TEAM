{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watercare.local/contracts/ai/3.0.0/common/SafetyAssessment.schema.json",
  "x-contract-version": "3.0.0",
  "title": "SafetyAssessment",
  "description": "위험도 및 안전 평가 결과 Schema",
  "type": "object",
  "required": [
    "risk_level",
    "priority",
    "requires_consultation",
    "matched_safety_rule_ids",
    "detected_risks",
    "safety_reason"
  ],
  "additionalProperties": false,
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": ["general", "caution", "danger"],
      "x-code-registry": "../../../codes/risk-levels.yaml",
      "description": "위험도 레벨"
    },
    "priority": {
      "type": "string",
      "enum": ["general_guidance", "consultation_recommended", "priority_consultation"],
      "description": "문의 처리 우선순위"
    },
    "requires_consultation": {
      "type": "boolean",
      "description": "상담 연결 필요 여부"
    },
    "matched_safety_rule_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SAFETY-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
      },
      "description": "실제 입력과 일치한 안정 안전 규칙 ID 목록"
    },
    "detected_risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "감지된 위험 요소 목록"
    },
    "safety_reason": {
      "type": "string",
      "description": "위험도 판정 사유 설명"
    }
  }
}
