{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SymptomAnalysisRequest.schema.json",
  "x-contract-version": "3.0.0",
  "title": "SymptomAnalysisRequest",
  "description": "증상 분석, 위험도 판정, RAG 근거 검색 및 사용 안내 요청",
  "type": "object",
  "required": ["inquiry_id", "correlation_id", "ai_request_id", "state_version", "raw_symptom", "model_code"],
  "additionalProperties": false,
  "properties": {
    "inquiry_id": {
      "type": "string",
      "format": "uuid",
      "description": "Backend가 발급한 Public UUID. 내부 정수 PK와 업무 코드는 금지"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Backend가 발급한 요청 추적 UUID"
    },
    "ai_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Backend가 AI 호출마다 발급하는 멱등 식별자. 동일 요청 재전송 시 재사용"
    },
    "state_version": {
      "type": "integer",
      "minimum": 1,
      "description": "AI 호출 시작 시점 문의 상태 버전"
    },
    "raw_symptom": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "model_code": { "type": "string", "minLength": 1, "maxLength": 100 },
    "selected_symptoms": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "previous_answers": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["question_id", "answer_text"],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "answer_text": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
