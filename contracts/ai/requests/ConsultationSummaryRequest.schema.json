{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ConsultationSummaryRequest.schema.json",
  "x-contract-version": "1.1.0",
  "title": "ConsultationSummaryRequest",
  "description": "상담 요약 초안 요청",
  "type": "object",
  "required": ["inquiry_id", "correlation_id", "ai_request_id", "state_version", "customer_raw_text"],
  "additionalProperties": false,
  "properties": {
    "inquiry_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "ai_request_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "state_version": { "type": "integer", "minimum": 1 },
    "customer_raw_text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "agent_notes": { "type": ["string", "null"], "maxLength": 8000 }
  }
}
