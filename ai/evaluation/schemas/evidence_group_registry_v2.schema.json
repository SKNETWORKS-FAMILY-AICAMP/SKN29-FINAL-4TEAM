{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waterbridge.local/schemas/evidence_group_registry_v2.schema.json",
  "title": "EvidenceGroupRegistryV2Row",
  "description": "Gold v2 의미 단위와 검색 가능한 Child Variant를 연결하는 Registry JSONL 행",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_group_id",
    "topic_code",
    "exact_sales_code",
    "document_id",
    "page_refs",
    "child_ids",
    "source_variant_ids",
    "consultation_conditions",
    "mapping_action",
    "supersedes_group_id",
    "activation_gates"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0-draft.1"},
    "evidence_group_id": {
      "type": "string",
      "pattern": "^EVD-[A-Z0-9]+-[A-Z0-9-]+-[0-9]{3}$"
    },
    "topic_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "exact_sales_code": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "page_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "child_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_variant_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "consultation_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "trigger_type",
          "source_child_ids",
          "source_page_refs"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "pattern": "^COND-[A-Z0-9-]+-[0-9]{3}$"
          },
          "trigger_type": {
            "enum": ["PERSISTENCE", "RECURRENCE", "AFTER_CHECK"]
          },
          "source_child_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_page_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "mapping_action": {
      "enum": [
        "CREATE_CHILD_AND_GROUP",
        "CREATE_GROUP_REMAP_EXISTING_CHILD",
        "REUSE_EXISTING_GROUP"
      ]
    },
    "supersedes_group_id": {
      "type": ["string", "null"],
      "pattern": "^EVD-[A-Z0-9]+-[A-Z0-9-]+-[0-9]{3}$"
    },
    "activation_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DATA_QA_SOURCE_SPAN_VERIFIED",
          "CHILD_HASH_REGENERATED",
          "CHILD_GROUP_ID_REMAPPED",
          "CORPUS_V3_LINKED"
        ]
      }
    }
  }
}
