# AI 서비스 실행 환경 설정
AI_ENV=development
AI_HOST=127.0.0.1
AI_PORT=8001
AI_LOG_LEVEL=INFO
AI_MAX_IN_FLIGHT_WORKERS=2
# 기본값은 안정된 Single RAG. 후보 3-Agent 검증 Process에서만 multi_agent 사용
AI_PIPELINE_RUNTIME=single_rag

# LLM 및 모델 설정
OPENAI_API_KEY=replace-with-secret
AI_LLM_MODEL=gpt-4.1-mini
# 선택값: 공식 OpenAI HTTPS /v1 Endpoint를 명시적으로 고정할 때만 설정
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Local RAG Runtime은 개별 POSTGRES_* 대신 아래 Secret DSN을 사용
AI_VECTOR_DSN=replace-with-team-minimum-privilege-dsn
AI_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# 팀 통합환경은 Backend가 게시한 읽기 전용 View를 사용한다.
AI_VECTOR_TABLE_NAME=backend_ai_rag_chunks_v1

# pgvector 데이터베이스 연결 설정
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=watercare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# 타임아웃 및 재시도 정책 설정
AI_SERVICE_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
