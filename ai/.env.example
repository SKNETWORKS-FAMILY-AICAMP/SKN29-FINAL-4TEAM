AI_ENV=development
AI_HOST=127.0.0.1
AI_PORT=8001
AI_LOG_LEVEL=INFO
AI_MAX_IN_FLIGHT_WORKERS=2
AI_PIPELINE_RUNTIME=multi_agent
AI_RETRIEVAL_TRANSPORT=mcp

OPENAI_API_KEY=replace-with-secret
AI_LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

AI_VECTOR_DSN=replace-with-team-minimum-privilege-dsn
AI_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
AI_VECTOR_TABLE_NAME=backend_ai_rag_chunks_v1

# pgvector 데이터베이스 연결 설정
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# 타임아웃 및 재시도 정책 설정
AI_SERVICE_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0

# OpenTelemetry traces: 기본 OFF. Collector 연결 시에만 활성화
AI_OTEL_ENABLED=false
OTEL_SERVICE_NAME=waterbridge-ai
# AI_OTEL_ENABLED=true일 때 필수
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# 외부 Collector 인증이 필요할 때만 Secret으로 주입
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<secret>


# AI -> Backend 상담 인계: 기본 OFF. Backend 내부 API 준비 시 활성화
AI_HANDOFF_BACKEND_ENABLED=false
AI_BACKEND_BASE_URL=http://127.0.0.1:8000
AI_HANDOFF_INTERNAL_TOKEN=replace-with-a-protected-ai-handoff-token
# Backend -> AI 공식 검토 거절 재개: 결합 E2E 승인 전까지 기본 OFF
AI_HUMAN_REVIEW_RESUME_ENABLED=false
AI_HUMAN_REVIEW_RESUME_TOKEN=replace-with-a-distinct-backend-to-ai-resume-token
AI_HANDOFF_TIMEOUT_SECONDS=2.0
