# Windows Android SDK example
sdk.dir=C\:\\Users\\Playdata\\AppData\\Local\\Android\\Sdk

# Physical device + adb reverse (recommended for this project)
BACKEND_BASE_URL=http://127.0.0.1:8000/

# Android emulator alternative: http://10.0.2.2:8000/
# Real keys stay only in local.properties and must never be committed.
KAKAO_NATIVE_APP_KEY=
