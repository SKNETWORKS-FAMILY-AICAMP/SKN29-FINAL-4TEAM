# Windows Android SDK 예시
sdk.dir=C\:\\Users\\Playdata\\AppData\\Local\\Android\\Sdk

# 실단말과 adb reverse를 사용하는 기본 Backend 주소
BACKEND_BASE_URL=http://127.0.0.1:8000/

# Android Emulator에서는 http://10.0.2.2:8000/ 을 사용할 수 있습니다.
# 실제 키와 환경값은 local.properties에만 저장하고 Git에 커밋하지 않습니다.
KAKAO_NATIVE_APP_KEY=

# 고객 앱 데이터 실행 모드
# REMOTE: 문의 생성·증상 제출은 실제 Backend를 사용하고 홈·안내는 계약된 합성 Fixture를 사용합니다.
# FAKE: 네트워크 쓰기 없이 전체 고객 흐름을 합성 데이터로 재현합니다.
CUSTOMER_CARE_MODE=REMOTE

# REMOTE 모드에서 문의를 생성할 Demo 고객의 실제 활성 구독 Public UUID입니다.
# 저장소에 실제 값을 커밋하지 말고 각 개발자의 local.properties에만 입력합니다.
DEMO_SUBSCRIPTION_ID=

# 발표용 Debug APK에서는 false를 유지합니다. 상태별 화면 검증이 필요할 때만 true로 변경합니다.
SHOW_DEVELOPER_TOOLS=false
